rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Helper for validating User document
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 128)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() <= 32)) &&
             data.country is string && data.country.size() <= 8 &&
             data.currency is string && data.currency.size() <= 8 &&
             data.language is string && data.language.size() <= 8 &&
             // CRITICAL SECURITY: Prevent users from setting admin fields
             !data.keys().hasAny(['isAdmin', 'role', 'isSuperadmin', 'permissions']) &&
             // CRITICAL SECURITY: Prevent client modification of server-managed fields
             !data.keys().hasAny(['accountAge', 'fraudScore', 'suspicionFlags']);
    }

    // Wallet fields that must NEVER be set by clients — only initialized/trusted server-side
    function hasWalletFields(data) {
      return data.keys().hasAny(['coinsBalance', 'lifetimeEarnings', 'streakDays', 'lastCheckInDate']);
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().uid == request.auth.uid &&
                       isValidUser(incoming()) &&
                       !hasWalletFields(incoming());
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().uid == existing().uid &&
                       isValidUser(incoming()) &&
                       !hasWalletFields(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'photoURL',
                         'country', 'currency',
                         'language', 'referredBy', 'updatedAt'
                       ]) || isAdmin();
      allow delete: if isAdmin();
    }

    // Polls Collection (Public readable for community participation)
    match /polls/{pollId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Poll Votes Collection
    function isValidPollVote(data) {
      return data.pollId is string && data.pollId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.selectedOptionIndex is int && data.selectedOptionIndex >= 0 &&
             data.earnedCoins is int && data.earnedCoins >= 0 && data.earnedCoins <= 500;
    }

    match /poll_votes/{voteId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() &&
                       isValidId(voteId) &&
                       isValidPollVote(incoming());
      allow update, delete: if isAdmin();
    }

    // Offers Collection
    match /offers/{offerId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // User Tasks Collection
    function isValidUserTask(data) {
      return data.offerId is string && data.offerId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.status in ['in_progress', 'completed', 'verified'] &&
             data.rewardCoins is int && data.rewardCoins >= 0;
    }

    match /user_tasks/{taskId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() &&
                       isValidId(taskId) &&
                       isValidUserTask(incoming());
      allow update: if (isSignedIn() &&
                       resource.data.userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().offerId == existing().offerId &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Redemptions Collection
    function isValidRedemption(data) {
      return data.userId == request.auth.uid &&
             data.payoutMethod is string && data.payoutMethod.size() <= 64 &&
             data.currency is string && data.currency.size() <= 8 &&
             data.coinsSpent is int && data.coinsSpent > 0 &&
             data.accountDetails is string && data.accountDetails.size() <= 256 &&
             data.status == 'pending';
    }

    match /redemptions/{redemptionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if false; // All redemption requests must go through the callable function
      allow update, delete: if isAdmin();
    }

    // System Settings Collection (Global app settings managed by admin)
    match /system_settings/{settingId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Provisioned via server or direct admin
    }

    // Test connection doc
    match /test/{docId} {
      allow get: if true;
      allow write: if false;
    }

    // Referral Rewards Collection - tracks one-time referral rewards
    // This is write-protected - only server/cloud functions can create records
    function isValidReferralReward(data) {
      return data.rewardId is string && data.rewardId.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 &&
             data.referrerId is string && data.referrerId.size() > 0 &&
             data.referralCode is string && data.referralCode.size() >= 5 &&
             data.amount is int && data.amount > 0 && data.amount <= 10000 &&
             data.type in ['bonus', 'referral_reward'] &&
             data.status in ['pending', 'completed', 'revoked'] &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('completedAt' in data) || data.completedAt is timestamp || data.completedAt == null) &&
             (!('revokedAt' in data) || data.revokedAt is timestamp || data.revokedAt == null) &&
             (!('expiresAt' in data) || data.expiresAt is timestamp || data.expiresAt == null) &&
             data.transactionId is string && data.transactionId.size() <= 128;
    }

    match /referral_rewards/{rewardId} {
      allow read: if isSignedIn() && (
                     resource.data.userId == request.auth.uid ||
                     isAdmin() ||
                     // Referrers can read rewards related to their referrals
                     (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      resource.data.referrerId == request.auth.uid)
                   );
      allow create: if false; // Only server-side writes via cloud functions
      allow update, delete: if isAdmin();
    }
  }
}