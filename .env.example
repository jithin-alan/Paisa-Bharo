# Paisa Bharo - Production Environment Template

# Firebase Client Web SDK (Public Configuration)
VITE_FIREBASE_PROJECT_ID=paisa-bharo-app
VITE_FIRESTORE_DATABASE_ID=ai-studio-ba803483-ddcf-496c-b3c9-7d1a85fc5692

# Firebase Secret Manager Credentials (Configured via `firebase functions:secrets:set <KEY>`)
CINT_API_KEY=your_cint_api_key_secret
ADGEM_SECRET=your_adgem_secret_key
BITLABS_SECRET=your_bitlabs_secret_key
AFFILIATE_SECRET=your_affiliate_secret_key
THEOREMREACH_API_KEY=your_theoremreach_api_key
THEOREMREACH_SECRET=your_theoremreach_secret_key
THEOREMREACH_PARTNER_ID=your_theoremreach_placement_id

# Security Safeguard Toggles (Enable for production coin crediting)
PAISA_BHARO_LIVE_PAYOUTS_ENABLED=true
PAISA_BHARO_LIVE_POSTBACKS_ENABLED=true

# TheoremReach Callback Configuration (Required for coin crediting)
THEOREMREACH_CALLBACK_BASE_URL=https://us-central1-paisa-bharo-app.cloudfunctions.net
